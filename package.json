{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/check-node-spawn.mjs && cross-env NODE_ENV=development tsx -r dotenv/config server/index.ts",
    "build": "node scripts/check-node-spawn.mjs && node scripts/generate-sitemap.mjs && vite build && node build-server.mjs",
    "audit:ui": "node ./scripts/ui-surface-audit.mjs",
    "audit:ui:next5": "node ./scripts/ui-surface-next5.mjs",
    "audit:ui:enforce": "node ./scripts/ui-surface-audit.mjs && node ./scripts/ui-surface-enforce.mjs",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "node scripts/check-node-spawn.mjs && cross-env NODE_ENV=test vitest",
    "test:run": "node scripts/check-node-spawn.mjs && cross-env NODE_ENV=test vitest run",
    "e2e": "node scripts/check-node-spawn.mjs && cross-env NODE_ENV=test playwright test",
    "e2e:ui": "cross-env NODE_ENV=test playwright test --ui",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "test:release-gates": "cross-env NODE_ENV=test playwright test tests/journeys/auth_buttons_present.spec.ts tests/address-verification.smoke.spec.ts tests/direct-connect.e2e.spec.ts tests/scout-routing.e2e.spec.ts --project=chromium",
    "report:release-gates": "node scripts/report-release-gates.mjs",
    "test:e2e:debug": "cross-env NODE_ENV=test playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:report:bot-army": "npx ts-node tests/report/generate_report.ts",
    "bot-army:watch": "nodemon --watch client/src --watch server --watch shared --ext ts,tsx,js,json --exec \"npm run test:e2e || exit 1\"",
    "bot-army:ui": "cross-env NODE_ENV=test playwright test --ui",
    "verify": "npm run check && npm run test:run && npm run audit:theme && npm run audit:blur && npm run verify:legacy-guard && npm run verify:scout-purity && npm run verify:shells && npm run verify:city-branding && npm run verify:no-vite",
    "verify:city-branding": "node scripts/verify-city-only-branding.mjs",
    "verify:legacy-guard": "node scripts/verify-legacy-guard.js",
    "verify:scout-purity": "node scripts/verify-scout-purity.js",
    "verify:scout-tiles": "node scripts/verify-scout-tiles.js",
    "verify:shells": "node scripts/verify-shell-architecture.js",
    "verify:no-vite": "node scripts/verify-no-vite-in-dist.mjs",
    "db:push": "drizzle-kit push",
    "db:push:test": "node scripts/withTestDb.mjs drizzle-kit push",
    "seed:e2e-user": "node scripts/withTestDb.mjs cross-env NODE_ENV=test tsx -r dotenv/config scripts/seed-e2e-user.ts",
    "test:run:db": "npm run db:push:test && npm run test:run",
    "seed:test-user": "cross-env NODE_ENV=development tsx -r dotenv/config scripts/seed-test-user.ts",
    "seed:states": "cross-env NODE_ENV=development tsx -r dotenv/config scripts/seed-states.ts",
    "seed:counties": "cross-env NODE_ENV=development tsx -r dotenv/config scripts/seed-counties.ts",
    "seed:geo": "cross-env NODE_ENV=development tsx -r dotenv/config scripts/seed-geographic-storage.ts",
    "audit:theme": "powershell -ExecutionPolicy Bypass -File scripts/audit-theme-lock.ps1",
    "audit:blur": "node scripts/audit-blur-ancestors.mjs",
    "audit:http-semantics": "node scripts/audit-http-semantics.mjs",
    "audit:authority-gates": "node scripts/audit-authority-gates.mjs",
    "audit:trust-leaks": "node scripts/audit-trust-leaks.mjs",
    "audit:observability-baselines": "node scripts/audit-observability-baselines.mjs",
    "audit:production-debt": "node scripts/audit-production-debt.mjs",
    "audit:secrets-history": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-secrets-history.ps1",
    "audit:latest-builder": "node tools/audit-latest-builder-branch.mjs",
    "backfill:decision-cards": "node scripts/backfill-decision-cards.mjs",
    "backfill:trust-snapshots": "node scripts/backfill-trust-snapshots.mjs",
    "guard:forbidden": "node scripts/forbidden-patterns.mjs",
    "verifier:write-backlog": "node tools/verifier-write-backlog.mjs",
    "loop:empirical": "node tools/loop-empirical.mjs",
    "validate:scout-deals": "node scripts/validate-deal-guardrail.mjs",
    "prepare": "husky",
    "lint": "eslint .",
    "pack:repo": "node scripts/pack-repo.mjs --out repo-pack.md",
    "agents:builder": "cross-env AGENTS_ENABLED=true AGENT_ROLE=builder AGENT_WRITE_SCOPE=branches_only AGENT_DB_SCOPE=seed_only AGENT_INTENT_BUDGET=10 AGENT_MAX_PARALLEL=1 AGENT_HEARTBEAT_SEC=30 SCHEDULER_ENABLED=false DISABLE_CRAWLER=true node agent-runtime/agent-supervisor.js"
  },
