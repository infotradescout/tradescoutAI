# NOTE (Windows/Node 24): Node subprocess spawning `git` can fail with EPERM in this repo.
# Keep the pre-commit hook pure shell to avoid Node spawning `git`.

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

node scripts/guard-scout-response-contract.mjs || exit 1

ESLINT_FILES="$(printf "%s\n" "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)"
FORMAT_FILES="$(printf "%s\n" "$STAGED_FILES" | grep -E '\.(ts|tsx|json|md)$' || true)"

if [ -n "$ESLINT_FILES" ]; then
  # shellcheck disable=SC2086
  npx eslint --fix $ESLINT_FILES
fi

if [ -n "$FORMAT_FILES" ]; then
  # shellcheck disable=SC2086
  prettier --write $FORMAT_FILES
  # shellcheck disable=SC2086
  git add $FORMAT_FILES
fi
