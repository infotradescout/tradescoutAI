# Local/production environment variables
# Copy this file to .env and fill in real values.

# Core
NODE_ENV=development
PORT=5000
DATABASE_URL=
TEST_DATABASE_URL=postgresql://tradescout:tradescoutpass@localhost:5433/tradescout_test
SESSION_SECRET=

# Beta window (controls Founder badge eligibility)
# Use ISO timestamps, e.g. 2025-12-01T00:00:00Z
# If BETA_START_AT is unset/invalid, no accounts receive the Founder badge.
# If BETA_END_AT is unset, beta is treated as ongoing.
BETA_START_AT=
BETA_END_AT=

# Admin bootstrap (creates head_admin if none exists on server start)
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MASTER_ADMIN_FIRST_NAME=Admin
MASTER_ADMIN_LAST_NAME=User

# LLM
GEMINI_API_KEY=

# Auth toggles
DISABLE_FACEBOOK_AUTH=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://www.thetradescout.com/api/auth/facebook/callback

# Public base URL used for email links (verify email, reset password, etc.)
PUBLIC_WEB_URL=https://www.thetradescout.com

# Transactional Email (Brevo)
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@tradescout.app

# Email sending mode:
# - all: allow all transactional emails (reset password, admin notices, etc.)
# - account_creation_only: only allow signup + email verification
EMAIL_MODE=all
# Add other secrets and config as needed
