# --- Core ---
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@host:port/dbname
TEST_DATABASE_URL=postgresql://user:password@host:port/dbname_test
SESSION_SECRET=your_long_random_session_secret_here

# --- Admin Bootstrap ---
# Creates head_admin if none exists on server start
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MASTER_ADMIN_FIRST_NAME=Admin
MASTER_ADMIN_LAST_NAME=User

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Transactional Email ---
# Supports SendGrid and Brevo
SENDGRID_API_KEY=SG....
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@tradescout.app
# EMAIL_PROVIDER=sendgrid # or brevo
# Optional: comma-separated recipients for Trade Partner landing submissions
TRADEPARTNER_INTEREST_EMAIL=info@your-domain.com

# --- Error Tracking ---
SENTRY_DSN=https://...@...ingest.sentry.io/...

# --- Storage (AWS S3) ---
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# --- Auth (Google) ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# --- JW Stone private member pricing (Google Drive) ---
# Canonical source: the Fabricator Pricing workbook in the approved JW STONE folder.
JW_STONE_DRIVE_FOLDER_ID=1Q8z9mjKWilONhSYgeD1Q3CqQkROJAfWW
JW_STONE_DRIVE_PRICING_FILE_ID=1qqi8lgedSFecuIozNe3TapkqzHuiz4YJ
# Preferred: base64-encoded service-account JSON. Share the JW STONE folder read-only
# with that service-account email. Alternatively configure the OAuth refresh token below.
JW_STONE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
JW_STONE_DRIVE_REFRESH_TOKEN=
# Optional operational bounds; validated prices are cached in server memory only.
JW_STONE_DRIVE_PRICING_CACHE_MS=300000
JW_STONE_DRIVE_REQUEST_TIMEOUT_MS=10000

# --- Auth (Facebook) ---
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/auth/facebook/callback

# --- App Configuration ---
PUBLIC_WEB_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
VITE_API_BASE_URL=https://your-api-domain.com
JSON_BODY_LIMIT=1mb
SCHEDULER_ENABLED=true
# Optional: only one instance runs scheduler and daily background jobs.
SCHEDULER_LEADER_ONLY=true
# Optional advisory lock id shared by all instances.
SCHEDULER_LEADER_LOCK_ID=72418031
# Optional Redis URL for cross-instance anti-scrape counters + Socket.IO fanout.
REDIS_URL=

# --- Admin-managed Pro Fab profile (server-only) ---
# Required to create the profile on first production boot. Keep real values in
# the deployment secret store; never commit them to source control.
PRO_FAB_OWNER_EMAIL=
# Optional. When omitted, Direct Connect remains request-only until a private
# routing phone is configured in the business record.
PRO_FAB_ROUTING_PHONE=

# --- Maps (Client/Public) ---
# Browser-safe key served by /api/public-config at runtime.
TRADESCOUT_GOOGLE_MAPS_API_KEY=
# Optional map style ID for Advanced Markers/custom styling.
VITE_GOOGLE_MAPS_MAP_ID=

# --- External Import Fetch Budget ---
# External provider timeout/retry controls for surge resilience.
TRADESCOUT_EXTERNAL_FETCH_TIMEOUT_MS=8000
TRADESCOUT_EXTERNAL_FETCH_RETRIES=2
TRADESCOUT_EXTERNAL_FETCH_BACKOFF_MS=250

# --- AI Model Configuration ---
# Default Gemini model used across TradeScout server AI callsites.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: Vertex-only override (falls back to GEMINI_MODEL when empty).
GOOGLE_VERTEX_GEMINI_MODEL=gemini-3.1-flash-lite

# --- ScoutFitters (Printful) ---
# Enables ScoutFitters order creation (preview + PNG download work without this).
PRINTFUL_API_KEY=
# Variant IDs are NOT secrets. Recommended: store them in DB via Admin → Site Settings:
# category: marketing
# key: scoutfitters_printful_variants
# value: {"high":123,"medium":456,"low":789}
# Optional fallback: env vars for each tier (configure these in your Printful catalog).
SCOUTFITTERS_PRINTFUL_VARIANT_ID_HIGH=
SCOUTFITTERS_PRINTFUL_VARIANT_ID_MEDIUM=
SCOUTFITTERS_PRINTFUL_VARIANT_ID_LOW=

# --- Beta Window ---
# Controls Founder badge eligibility (ISO timestamps)
BETA_START_AT=2025-12-01T00:00:00Z
BETA_END_AT=

# --- Scout AI Enhancement (Phase 1) ---
# Enable enhanced Scout features with structured reasoning and dynamic tool use
SCOUT_ENHANCED_ENABLED=false
# Use enhanced system prompt (v2.0) instead of standard prompt (v1.0)
SCOUT_USE_ENHANCED_PROMPT=false
# Prompt version: "v1" for standard, "v2" for enhanced
SCOUT_PROMPT_VERSION=v1

# --- Scout Brain hybrid retrieval ---
# Shadow mode records hashed comparison telemetry and never changes the answer.
SCOUT_HYBRID_SHADOW_ENABLED=false
# Cutover remains fail-closed unless the artifact uses production embeddings
# and every returned result has a real source URL.
SCOUT_HYBRID_CUTOVER_ENABLED=false
SCOUT_HYBRID_INDEX_PATH=data/scout-hybrid-index.v1.json
SCOUT_HYBRID_ALLOW_OFFLINE_EMBEDDINGS=false

# --- Solar v1 (Provider Workbench First) ---
# Master gate for /api/solar/provider/estimate and /api/public/solar/price-range
FEATURE_SOLAR_V1=false
# Enables future external provider calls when GOOGLE_SOLAR_API_KEY is configured.
# Phase 1 still returns explainable fallback math through TradeScout-controlled logic.
FEATURE_SOLAR_GOOGLE_PROVIDER=false
# Server-side key only. Do not expose in client env.
GOOGLE_SOLAR_API_KEY=
# Optional fallback model assumptions used by Solar v1 estimates.
SOLAR_DEFAULT_COST_PER_WATT_USD=2.8
SOLAR_DEFAULT_ELECTRIC_RATE_USD=0.16
