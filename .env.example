# --- Core ---
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@host:port/dbname
TEST_DATABASE_URL=postgresql://user:password@host:port/dbname_test
SESSION_SECRET=your_long_random_session_secret_here

# --- Admin Bootstrap ---
# Creates head_admin if none exists on server start
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MASTER_ADMIN_FIRST_NAME=Admin
MASTER_ADMIN_LAST_NAME=User

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Transactional Email ---
# Supports SendGrid and Brevo
SENDGRID_API_KEY=SG....
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@tradescout.app
# EMAIL_PROVIDER=sendgrid # or brevo
# Optional: comma-separated recipients for Trade Partner landing submissions
TRADEPARTNER_INTEREST_EMAIL=info@your-domain.com

# --- Error Tracking ---
SENTRY_DSN=https://...@...ingest.sentry.io/...

# --- Storage (AWS S3) ---
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# --- Auth (Google) ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# --- Auth (Facebook) ---
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/auth/facebook/callback

# --- App Configuration ---
PUBLIC_WEB_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
VITE_API_BASE_URL=https://your-api-domain.com
JSON_BODY_LIMIT=1mb
SCHEDULER_ENABLED=true

# --- Maps (Client/Public) ---
# Browser-safe key used by the frontend build/runtime.
VITE_GOOGLE_MAPS_WEB_API_KEY=
# Backward-compatible alias (used by older builds).
VITE_GOOGLE_MAPS_API_KEY=
# Optional map style ID for Advanced Markers/custom styling.
VITE_GOOGLE_MAPS_MAP_ID=

# --- AI Model Configuration ---
# Default Gemini model used across TradeScout server AI callsites.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: Vertex-only override (falls back to GEMINI_MODEL when empty).
GOOGLE_VERTEX_GEMINI_MODEL=gemini-3.1-flash-lite

# --- ScoutFitters (Printful) ---
# Enables ScoutFitters order creation (preview + PNG download work without this).
PRINTFUL_API_KEY=
# Variant IDs are NOT secrets. Recommended: store them in DB via Admin → Site Settings:
# category: marketing
# key: scoutfitters_printful_variants
# value: {"high":123,"medium":456,"low":789}
# Optional fallback: env vars for each tier (configure these in your Printful catalog).
SCOUTFITTERS_PRINTFUL_VARIANT_ID_HIGH=
SCOUTFITTERS_PRINTFUL_VARIANT_ID_MEDIUM=
SCOUTFITTERS_PRINTFUL_VARIANT_ID_LOW=

# --- Beta Window ---
# Controls Founder badge eligibility (ISO timestamps)
BETA_START_AT=2025-12-01T00:00:00Z
BETA_END_AT=

# --- Scout AI Enhancement (Phase 1) ---
# Enable enhanced Scout features with structured reasoning and dynamic tool use
SCOUT_ENHANCED_ENABLED=false
# Use enhanced system prompt (v2.0) instead of standard prompt (v1.0)
SCOUT_USE_ENHANCED_PROMPT=false
# Prompt version: "v1" for standard, "v2" for enhanced
SCOUT_PROMPT_VERSION=v1
