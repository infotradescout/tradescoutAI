# Local/production environment variables
# Copy this file to .env and fill in real values.

# Core
NODE_ENV=development
PORT=5000
DATABASE_URL=
TEST_DATABASE_URL=postgresql://tradescout:tradescoutpass@localhost:5433/tradescout_test
SESSION_SECRET=

# Admin bootstrap (creates head_admin if none exists on server start)
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MASTER_ADMIN_FIRST_NAME=Admin
MASTER_ADMIN_LAST_NAME=User

# LLM
GEMINI_API_KEY=

# Auth toggles
DISABLE_FACEBOOK_AUTH=true
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Add other secrets and config as needed
