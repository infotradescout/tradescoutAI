  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "incremental": false,
    "tsBuildInfoFile": "/dev/null"
  },
  "include": [
    "server/deviceAuth.ts",
    "server/db.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
