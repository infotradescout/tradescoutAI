{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["client/src/*"],
      "@shared/*": ["shared/*"],
      "@db/*": ["shared/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../types/**/*.d.ts"],
  "exclude": ["../../node_modules", "../../dist", "../../build"]
}
