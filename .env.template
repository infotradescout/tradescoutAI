# TradeScout Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgres://user:pass@host/db
PGDATABASE=tradescout
PGHOST=localhost
PGPASSWORD=your_password
PGPORT=5432
PGUSER=your_user

# Session Security
SESSION_SECRET=change_me_long_random_string_for_production

# Payments (optional until you enable)
STRIPE_SECRET_KEY=sk_test_or_live_key
VITE_STRIPE_PUBLIC_KEY=pk_test_or_live_key

# Email Service (optional)
SENDGRID_API_KEY=your_sendgrid_api_key

# Social Authentication (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Replit Integration
REPL_ID=your_repl_id
REPLIT_DOMAINS=your-repl-domain.replit.app
ISSUER_URL=https://replit.com/oidc

# Client Configuration
VITE_API_URL=http://localhost:5000