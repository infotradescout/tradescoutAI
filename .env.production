# Production Environment Variables for thetradescout.com
NODE_ENV=production

# Database
DATABASE_URL=your_production_database_url_here

# Session Secret (generate a new one: openssl rand -base64 32)
SESSION_SECRET=your_production_session_secret_here

# OAuth (Facebook) - Optional
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://thetradescout.com/auth/facebook/callback

# Domain
DOMAIN=thetradescout.com
BASE_URL=https://thetradescout.com

# Port (for Railway/Render)
PORT=5000

# Disable certain dev features in production
DISABLE_FACEBOOK_AUTH=true
