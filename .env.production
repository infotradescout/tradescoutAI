# Production Environment Variables for thetradescout.com
NODE_ENV=production

# Database (REQUIRED - set to your production Neon/Postgres URL)
DATABASE_URL=your_production_database_url_here

# Session Secret (REQUIRED - generate a new one: openssl rand -base64 32)
# Current placeholder - MUST be changed to a secure random string in production
SESSION_SECRET=replace_with_secure_random_string_openssl_rand_base64_32

# LLM Configuration (REQUIRED for Scout AI features)
# Generate API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_production_gemini_api_key_here

# OAuth (Facebook) - Optional
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://thetradescout.com/auth/facebook/callback

# Domain
DOMAIN=thetradescout.com
BASE_URL=https://thetradescout.com

# Port (for Railway/Render)
PORT=5000

# Disable certain dev features in production
DISABLE_FACEBOOK_AUTH=true
